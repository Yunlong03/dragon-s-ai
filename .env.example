# Contact form mail settings. Set the real values in Hostinger's environment variables, never in this file.
# Proton SMTP submission: host smtp.protonmail.ch, port 587 (STARTTLS); SMTP_PASS is a Proton SMTP token.
# If any of these is missing, POST /api/contact returns 503 and the form shows the mailto fallback.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
